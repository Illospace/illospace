ensure_deno_runtime() {
  local deno_install="${ILLO_DENO_INSTALL:-$ROOT/.runtime/deno}"
  local deno_bin="$deno_install/bin"
  local deno_exe="$deno_bin/deno"

  path_prepend_once "$deno_bin"

  if [ "${ILLO_SKIP_DENO_INSTALL:-0}" = "1" ]; then
    dim "Skipping Deno runtime check (ILLO_SKIP_DENO_INSTALL=1)"
    return 0
  fi

  if command -v deno >/dev/null 2>&1; then
    dim "Deno runtime ready ($(command -v deno))"
    return 0
  fi

  if ! command -v curl >/dev/null 2>&1; then
    warn "curl not found — cannot auto-install Deno. PredictRLM workers will fall back to native."
    return 1
  fi

  if ! command -v unzip >/dev/null 2>&1; then
    warn "unzip not found — cannot auto-install Deno. PredictRLM workers will fall back to native."
    return 1
  fi

  info "Installing Deno runtime for PredictRLM workers..."
  mkdir -p "$deno_install"

  local install_script
  install_script="$(mktemp "${TMPDIR:-/tmp}/illo-deno-install.XXXXXX")"

  if ! curl -fsSL https://deno.land/install.sh -o "$install_script"; then
    rm -f "$install_script"
    warn "Failed to download Deno installer — PredictRLM workers will fall back to native."
    return 1
  fi

  if ! DENO_INSTALL="$deno_install" sh "$install_script" -y >/tmp/illo-deno-install.log 2>&1; then
    rm -f "$install_script"
    warn "Deno install failed — see /tmp/illo-deno-install.log. PredictRLM workers will fall back to native."
    return 1
  fi

  rm -f "$install_script"
  path_prepend_once "$deno_bin"

  if [ -x "$deno_exe" ]; then
    info "Deno runtime ready ($deno_exe)"
    return 0
  fi

  warn "Deno install finished but the binary was not found at $deno_exe"
  return 1
}

sync_frontend_dependencies() {
  if [ ! -d "$ROOT/frontend" ]; then
    return 0
  fi

  if [ -d "$ROOT/frontend/node_modules" ]; then
    info "Syncing frontend dependencies..."
  else
    info "Installing frontend dependencies..."
  fi

  "$ROOT/ops/sync-frontend-deps.sh" --quiet || {
    err "Failed to install frontend dependencies"
    exit 1
  }
}

ensure_hf_cli() {
  if [ -x "$ROOT/venv/bin/hf" ] || command -v hf &>/dev/null; then
    return 0
  fi

  "$ROOT/venv/bin/pip" install -q "huggingface_hub[cli]" 2>/dev/null || return 1
