offload_ollama_models() {
  if ! curl --max-time 3 -sf http://localhost:11434/api/tags >/dev/null 2>&1; then
    return
  fi

  dim "Offloading Ollama models to free VRAM..."
  "$ROOT/venv/bin/python3" - <<'PY' >/dev/null 2>&1 || true
import json
import urllib.request

base = "http://localhost:11434"
models = set()
try:
    with urllib.request.urlopen(f"{base}/api/ps", timeout=5) as resp:
        payload = json.load(resp)
    for item in payload.get("models", []):
        name = item.get("name") or item.get("model")
        if name:
            models.add(name)
except Exception:
    pass

if not models:
    models.update({"qwen3.5:4b", "qwen3:4b", "llama3.2:3b"})

for model in sorted(models):
    body = json.dumps({"model": model, "prompt": "", "keep_alive": "0"}).encode()
    req = urllib.request.Request(
        f"{base}/api/generate",
        data=body,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        urllib.request.urlopen(req, timeout=10).read()
    except Exception:
        pass
PY
  sleep 2
}

run_with_timeout() {
  local timeout_seconds="$1"
  shift

  "$@" &
  local cmd_pid=$!
  local elapsed=0

  while kill -0 "$cmd_pid" 2>/dev/null; do
    if [ "$elapsed" -ge "$timeout_seconds" ]; then
      kill "$cmd_pid" 2>/dev/null || true
      sleep 1
      if kill -0 "$cmd_pid" 2>/dev/null; then
        kill -KILL "$cmd_pid" 2>/dev/null || true
      fi
      wait "$cmd_pid" 2>/dev/null || true
      return 124
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done

  wait "$cmd_pid"
}

run_logged_timeout() {
  local timeout_seconds="$1"
  shift
  local log_path
  log_path="$(launch_log_path)"
  ensure_launch_log_dir
  launch_log "run (${timeout_seconds}s timeout): $*"
  run_with_timeout "$timeout_seconds" "$@" >> "$log_path" 2>&1
  local status=$?
  launch_log "exit $status: $*"
  return "$status"
}

docker_available() {
  ensure_docker_path || return 1
  run_with_timeout 5 "$DOCKER_BIN" info >/dev/null 2>&1 && return 0
  try_start_docker_daemon && return 0

  if [ "$(basename "$DOCKER_BIN")" = "docker" ] && command -v podman >/dev/null 2>&1; then
    local previous_bin="$DOCKER_BIN"
    DOCKER_BIN="$(command -v podman)"
    if run_with_timeout 5 "$DOCKER_BIN" info >/dev/null 2>&1; then
      export PATH="$(dirname "$DOCKER_BIN"):$PATH"
      return 0
    fi
    DOCKER_BIN="$previous_bin"
  fi

  return 1
}

docker_db_published_port() {
  ensure_docker_path || return 1
  run_with_timeout 5 "$DOCKER_BIN" port illo-db 5432/tcp 2>/dev/null \
    | awk -F: 'NF {print $NF; exit}'
}

is_truthy() {
  case "${1:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

port_process_pids() {
  local port="$1"
  lsof -ti tcp:"$port" -sTCP:LISTEN 2>/dev/null | sort -u | tr '\n' ' '
}

pid_command() {
  local pid="$1"
  ps -p "$pid" -o command= 2>/dev/null || true
}

pid_looks_illo_runtime() {
  local pid="$1"
  local command
  command="$(pid_command "$pid")"
  [ -n "$command" ] || return 1

  [[ "$command" == *"$ROOT"* ]] && return 0
  [[ "$command" =~ (python|uvicorn).*brain\.app\.api\.main ]] && return 0
  [[ "$command" =~ brain\.platform\.gpu ]] && return 0
  [[ "$command" =~ (npm|vite).*5173 ]] && return 0
  return 1
}

pids_look_illo_runtime() {
  local pids="$1"
  local pid
  for pid in $pids; do
    if ! pid_looks_illo_runtime "$pid"; then
      return 1
    fi
  done
  return 0
}

describe_pids() {
  local pids="$1"
  local pid command
  for pid in $pids; do
    command="$(pid_command "$pid")"
    echo "  $pid ${command:-<exited>}"
  done
}

stop_port_processes() {
  local port="$1"
  local label="${2:-runtime}"
  local pids
  pids="$(port_process_pids "$port")"
  [ -n "${pids//[[:space:]]/}" ] || return 0

  if is_truthy "${ILLO_FORCE_KILL_PORTS:-0}"; then
    warn "Port $port is in use; ILLO_FORCE_KILL_PORTS=1 so killing process(es) for $label"
  elif pids_look_illo_runtime "$pids"; then
    warn "Port $port is already used by Illo process(es); stopping them so this launch owns $label"
  else
    err "Port $port is already in use by non-Illo process(es):"
    describe_pids "$pids" >&2
    err "Stop that process, change the port, or set ILLO_FORCE_KILL_PORTS=1 if you want ./illo to kill it."
    exit 1
  fi

  echo "$pids" | xargs kill -9 2>/dev/null || true
}

is_local_db_host() {
  case "${1:-}" in
    localhost|127.0.0.1|::1) return 0 ;;
    *) return 1 ;;
  esac
}

tcp_port_listening() {
  local host="$1"
  local port="$2"
  python3 - "$host" "$port" <<'PY' >/dev/null 2>&1
import socket
import sys

host = sys.argv[1]
port = int(sys.argv[2])
try:
    with socket.create_connection((host, port), timeout=0.5):
        pass
except OSError:
    raise SystemExit(1)
PY
}

port_available() {
  local port="$1"
  python3 - "$port" <<'PY' >/dev/null 2>&1
import socket
import sys

port = int(sys.argv[1])
with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        sock.bind(("127.0.0.1", port))
    except OSError:
        raise SystemExit(1)
PY
}

find_available_db_port() {
  local port
  for port in {55432..55442}; do
    if port_available "$port"; then
      echo "$port"
      return 0
    fi
  done
  return 1
}

sql_ident() {
  python3 - "$1" <<'PY'
import sys

value = sys.argv[1]
print('"' + value.replace('"', '""') + '"')
PY
}

sql_literal() {
  python3 - "$1" <<'PY'
import sys

value = sys.argv[1]
print("'" + value.replace("'", "''") + "'")
PY
}

run_postgres_admin_sql() {
  local db_host="$1"
  local db_port="$2"
  local sql_file="$3"
  local psql_bin

  if psql_bin="$(find_psql_bin)"; then
    if run_with_timeout 10 env PGCONNECT_TIMEOUT="${PGCONNECT_TIMEOUT:-3}" "$psql_bin" -w \
      -h "$db_host" -p "$db_port" -U postgres -d postgres \
      -v ON_ERROR_STOP=1 -f "$sql_file" >/dev/null 2>&1; then
      return 0
    fi
    if run_with_timeout 10 env PGCONNECT_TIMEOUT="${PGCONNECT_TIMEOUT:-3}" "$psql_bin" -w \
      -h "$db_host" -p "$db_port" -d postgres \
      -v ON_ERROR_STOP=1 -f "$sql_file" >/dev/null 2>&1; then
      return 0
    fi
  fi

  if command -v sudo &>/dev/null && [ -n "${psql_bin:-}" ]; then
    if run_with_timeout 10 sudo -n -u postgres env PGCONNECT_TIMEOUT="${PGCONNECT_TIMEOUT:-3}" "$psql_bin" -w \
      -p "$db_port" -d postgres \
      -v ON_ERROR_STOP=1 -f "$sql_file" >/dev/null 2>&1; then
      return 0
    fi
  fi

  return 1
}

bootstrap_local_postgres_db() {
  local db_host="$1"
  local db_port="$2"
  local db_user="$3"
  local db_pass="$4"
  local db_name="$5"

  if ! is_local_db_host "$db_host" || ! psql_available; then
    return 1
  fi

  local user_ident db_ident user_lit pass_lit db_lit sql_file
  user_ident="$(sql_ident "$db_user")"
  db_ident="$(sql_ident "$db_name")"
  user_lit="$(sql_literal "$db_user")"
  pass_lit="$(sql_literal "$db_pass")"
  db_lit="$(sql_literal "$db_name")"
  sql_file="$(mktemp "${TMPDIR:-/tmp}/illo-postgres-bootstrap.XXXXXX.sql")"

  cat > "$sql_file" <<SQL
DO \$\$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = ${user_lit}) THEN
    EXECUTE format('CREATE ROLE %I LOGIN PASSWORD %L', ${user_lit}, ${pass_lit});
  ELSE
    EXECUTE format('ALTER ROLE %I WITH LOGIN PASSWORD %L', ${user_lit}, ${pass_lit});
  END IF;
END
\$\$;
SELECT format('CREATE DATABASE %I OWNER %I', ${db_lit}, ${user_lit})
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = ${db_lit})\\gexec
\\connect ${db_ident}
CREATE EXTENSION IF NOT EXISTS vector;
SQL

  if run_postgres_admin_sql "$db_host" "$db_port" "$sql_file"; then
    rm -f "$sql_file"
    return 0
  fi

  rm -f "$sql_file"
  return 1
}

managed_postgres_exists() {
  [ -s "$LOCAL_POSTGRES_DATA_DIR/PG_VERSION" ]
}

ensure_managed_postgres_db() {
  local db_user="$1"
  local db_pass="$2"
  local db_name="$3"
  local pg_bin_dir port
  local started_here=0

  is_truthy "${ILLO_DISABLE_MANAGED_POSTGRES:-0}" && return 1
  pg_bin_dir="$(find_postgres_bin_dir)" || return 1

  mkdir -p "$LOCAL_POSTGRES_RUNTIME_DIR"
  chmod 700 "$LOCAL_POSTGRES_RUNTIME_DIR" 2>/dev/null || true
  if ! managed_postgres_exists; then
    info "Creating repo-local PostgreSQL cluster..."
    launch_log "creating managed PostgreSQL cluster at $LOCAL_POSTGRES_DATA_DIR"
    if ! run_with_timeout 60 "$pg_bin_dir/initdb" \
      -D "$LOCAL_POSTGRES_DATA_DIR" \
      -U postgres \
      --encoding=UTF8 \
      --auth-local=trust \
      --auth-host=trust \
      >> "$LOCAL_POSTGRES_LOG" 2>&1; then
      warn "Could not create repo-local PostgreSQL cluster"
      launch_log "managed PostgreSQL initdb failed; see $LOCAL_POSTGRES_LOG"
      return 1
    fi
  fi

  if [ -f "$LOCAL_POSTGRES_PORT_FILE" ]; then
    port="$(tr -cd '0-9' < "$LOCAL_POSTGRES_PORT_FILE" | head -c 5)"
  fi
  if [ -z "${port:-}" ] && [ -f "$LOCAL_POSTGRES_DATA_DIR/postmaster.pid" ]; then
    port="$(sed -n '4p' "$LOCAL_POSTGRES_DATA_DIR/postmaster.pid" | tr -cd '0-9' | head -c 5)"
  fi
  if [ -z "${port:-}" ]; then
    port="$(find_available_db_port || true)"
  fi
  [ -n "${port:-}" ] || return 1

  if ! "$pg_bin_dir/pg_ctl" -D "$LOCAL_POSTGRES_DATA_DIR" status >/dev/null 2>&1; then
    if tcp_port_listening "127.0.0.1" "$port"; then
      port="$(find_available_db_port || true)"
      [ -n "$port" ] || return 1
    fi
    echo "$port" > "$LOCAL_POSTGRES_PORT_FILE"
    info "Starting repo-local PostgreSQL on 127.0.0.1:$port..."
    launch_log "starting managed PostgreSQL on port $port"
    if ! run_with_timeout 45 "$pg_bin_dir/pg_ctl" \
      -D "$LOCAL_POSTGRES_DATA_DIR" \
      -l "$LOCAL_POSTGRES_LOG" \
      -o "-p $port -c listen_addresses=127.0.0.1 -c unix_socket_directories=$LOCAL_POSTGRES_RUNTIME_DIR" \
      -w start >/dev/null 2>&1; then
      warn "Could not start repo-local PostgreSQL"
      tail -20 "$LOCAL_POSTGRES_LOG" 2>/dev/null | sed 's/^/  /' >&2 || true
      launch_log "managed PostgreSQL start failed; see $LOCAL_POSTGRES_LOG"
      return 1
    fi
    started_here=1
  fi

  MANAGED_POSTGRES_PORT="$port"
  if bootstrap_local_postgres_db "127.0.0.1" "$port" "$db_user" "$db_pass" "$db_name"; then
    export PGPASSWORD="$db_pass"
    if run_psql_no_prompt -h "127.0.0.1" -p "$port" -U "$db_user" -d "$db_name" -c "SELECT 1" >/dev/null 2>&1; then
      unset PGPASSWORD
      export DB_HOST="127.0.0.1"
      export DB_PORT="$port"
      info "Database ready in repo-local PostgreSQL at 127.0.0.1:$port"
      return 0
    fi
    unset PGPASSWORD
  fi

  warn "Repo-local PostgreSQL is available, but Illo could not prepare '$db_name'."
  warn "Usually this means the PostgreSQL installation is missing the pgvector extension."
  if [ $started_here -eq 1 ]; then
    run_with_timeout 30 "$pg_bin_dir/pg_ctl" -D "$LOCAL_POSTGRES_DATA_DIR" -m fast -w stop >/dev/null 2>&1 || true
  fi
  return 1
}

stop_managed_postgres_for_uninstall() {
  local dry_run="$1"
  local pg_bin_dir
  [ -d "$LOCAL_POSTGRES_DATA_DIR" ] || return 0
  pg_bin_dir="$(find_postgres_bin_dir)" || return 0

  if ! "$pg_bin_dir/pg_ctl" -D "$LOCAL_POSTGRES_DATA_DIR" status >/dev/null 2>&1; then
    return 0
  fi

  if [ "$dry_run" = "1" ]; then
    echo "Would stop repo-local PostgreSQL"
    return 0
  fi

  run_with_timeout 30 "$pg_bin_dir/pg_ctl" -D "$LOCAL_POSTGRES_DATA_DIR" -m fast -w stop >/dev/null 2>&1 || \
    warn "Failed to stop repo-local PostgreSQL cleanly"
}

# ── Prerequisites ──────────────────────────────────────────

check_prereqs() {
  local missing=0

  if ! command -v python3 &>/dev/null; then
    err "python3 not found — install Python 3.11+"
    missing=1
  fi

  if ! command -v node &>/dev/null; then
    err "node not found — install Node.js 22+"
    missing=1
  fi

  if ! ensure_docker_path && ! find_postgres_bin_dir >/dev/null 2>&1; then
    dim "No container runtime or PostgreSQL server tools found — will need external PostgreSQL"
  fi

  if [ $missing -eq 1 ]; then
    exit 1
  fi
}

# ── Database ──────────────────────────────────────────────

ensure_db() {
  log_phase "database: check/start"
  source_env
  apply_uninstall_database_env_reset
  local db_settings_configured=0
  local db_port_configured=0
  local db_var
  for db_var in "${DATABASE_ENV_VARS[@]}"; do
    if [ "${!db_var+x}" = "x" ]; then
      db_settings_configured=1
    fi
  done
  if [ "${DB_PORT+x}" = "x" ]; then
    db_port_configured=1
  fi
  local db_user="${DB_USER:-illo}"
  local db_pass="${DB_PASSWORD:-illo}"
  local db_name="${DB_NAME:-illo_memory}"
  local db_host="${DB_HOST:-127.0.0.1}"
  local db_port="${DB_PORT:-5432}"
  local db_reachable=1
  local postgres_listening=1

  if [ $db_settings_configured -eq 0 ] && managed_postgres_exists; then
    dim "Using existing repo-local PostgreSQL runtime"
    if ensure_managed_postgres_db "$db_user" "$db_pass" "$db_name"; then
      db_host="127.0.0.1"
      db_port="$MANAGED_POSTGRES_PORT"
      db_reachable=0
      postgres_listening=0
    fi
  fi

  # Check whether Illo can actually connect to its configured database. A plain
  # pg_isready success only means something is listening on the port; it does
  # not prove the DB/user/password are usable.
  if [ $db_reachable -ne 0 ] && command -v pg_isready &>/dev/null && \
     pg_isready -h "$db_host" -p "$db_port" &>/dev/null 2>&1; then
    postgres_listening=0
  elif [ $db_reachable -ne 0 ] && tcp_port_listening "$db_host" "$db_port"; then
    postgres_listening=0
  fi
  if [ $db_reachable -ne 0 ] && db_connection_ok "$db_host" "$db_port" "$db_name" "$db_user" "$db_pass"; then
    db_reachable=0
  fi

  if [ $db_reachable -eq 0 ]; then
    dim "Database reachable at $db_host:$db_port"
    launch_log "database reachable at $db_host:$db_port"
  else
    if [ $postgres_listening -eq 0 ]; then
      if [ $db_settings_configured -eq 0 ] && is_local_db_host "$db_host"; then
        warn "Postgres is listening at $db_host:$db_port, but Illo cannot connect to '$db_name' as '$db_user'"
        dim "No DB_* settings were provided — trying to bootstrap the default Illo database in local Postgres..."
        if bootstrap_local_postgres_db "$db_host" "$db_port" "$db_user" "$db_pass" "$db_name"; then
          if db_connection_ok "$db_host" "$db_port" "$db_name" "$db_user" "$db_pass"; then
            db_reachable=0
          fi
          if [ $db_reachable -eq 0 ]; then
            info "Database bootstrapped in local Postgres at $db_host:$db_port"
          fi
        else
          dim "Could not bootstrap local Postgres automatically; trying container/repo-local fallback next"
        fi
      fi
    fi
  fi

  if [ $db_reachable -eq 0 ]; then
    :
  else
    if [ $postgres_listening -eq 0 ]; then
      if [ $db_port_configured -eq 0 ] && is_local_db_host "$db_host" && docker_available; then
        local fallback_port
        fallback_port="$(docker_db_published_port || true)"
        if [ -z "$fallback_port" ]; then
          fallback_port="$(find_available_db_port || true)"
        fi
        if [ -n "$fallback_port" ]; then
          warn "Postgres is listening at $db_host:$db_port, but Illo cannot connect to '$db_name' as '$db_user'"
          dim "DB_PORT was not explicitly configured — using pgvector Docker database on 127.0.0.1:$fallback_port for this launch"
          db_host="127.0.0.1"
          db_port="$fallback_port"
          export DB_HOST="$db_host"
          export DB_PORT="$db_port"
          postgres_listening=1
        else
          err "Postgres is listening at $db_host:$db_port, and no alternate local DB port is available for Docker fallback"
          err "Stop/reconfigure this Postgres, set DB_PORT to a free port, or install pgvector in the existing server"
          exit 1
        fi
      elif [ $db_port_configured -eq 0 ] && [ $db_settings_configured -eq 0 ] && is_local_db_host "$db_host" && ensure_managed_postgres_db "$db_user" "$db_pass" "$db_name"; then
        db_host="127.0.0.1"
        db_port="$MANAGED_POSTGRES_PORT"
        db_reachable=0
        postgres_listening=0
      else
        err "Postgres is listening at $db_host:$db_port, but Illo cannot connect to database '$db_name' as user '$db_user'"
        if [ $db_port_configured -eq 0 ] && [ $db_settings_configured -eq 0 ] && is_local_db_host "$db_host"; then
          err "Illo could not bootstrap that Postgres, use a Docker/Podman pgvector fallback, or prepare repo-local PostgreSQL."
          err "Start Docker/Podman, install pgvector for local PostgreSQL, or provide DATABASE_URL/DB_* settings."
          exit 1
        fi
        if [ $db_port_configured -eq 1 ]; then
          err "DB_PORT is set in your shell environment or .env, so ./illo is respecting it instead of choosing an alternate Docker port"
          err "For a fresh-install test, run: env -u DB_HOST -u DB_PORT -u DB_NAME -u DB_USER -u DB_PASSWORD ./illo setup"
        fi
        err "Create that DB/user with pgvector, update DB_* settings, or unset DB_PORT so ./illo can choose a pgvector Docker fallback port"
        exit 1
      fi
    fi

    if [ $db_reachable -ne 0 ]; then
      # No usable native Postgres — use a container runtime or repo-local Postgres.
      launch_log "database not reachable at $db_host:$db_port; checking container runtime"
      if ! docker_available; then
        if [ $db_settings_configured -eq 0 ] && ensure_managed_postgres_db "$db_user" "$db_pass" "$db_name"; then
          db_host="127.0.0.1"
          db_port="$MANAGED_POSTGRES_PORT"
          db_reachable=0
        else
          err "No database at $db_host:$db_port and no usable container runtime is available"
          if ensure_docker_path; then
            err "Docker/Podman is installed but not responding for this user."
            err "On Linux, try: sudo systemctl start docker"
            err "If Docker says permission denied, add this user to the docker group and start a new shell."
          fi
          err "Install Docker/Podman, install PostgreSQL server tools plus pgvector, or provide DATABASE_URL/DB_* settings."
          exit 1
        fi
      fi
    fi

    if [ $db_reachable -ne 0 ]; then
    local running_containers
    launch_log "checking illo-db Docker container"
    running_containers="$(run_with_timeout 10 "$DOCKER_BIN" ps --format '{{.Names}}' 2>/dev/null || true)"
    if echo "$running_containers" | grep -q '^illo-db$'; then
      dim "Database container running"
      launch_log "database container already running"
    else
      local existing_containers
      existing_containers="$(run_with_timeout 10 "$DOCKER_BIN" ps -a --format '{{.Names}}' 2>/dev/null || true)"
      if echo "$existing_containers" | grep -q '^illo-db$'; then
        info "Starting database container..."
        launch_log "starting existing illo-db container"
        run_with_timeout 15 "$DOCKER_BIN" start illo-db >/dev/null || {
          err "Failed to start database container"
          exit 1
        }
      else
        info "Creating database container..."
        launch_log "creating illo-db container on host port $db_port"
        run_with_timeout 20 "$DOCKER_BIN" run -d \
          --name illo-db \
          -e POSTGRES_DB="$db_name" \
          -e POSTGRES_USER="$db_user" \
          -e POSTGRES_PASSWORD="$db_pass" \
          -p "$db_port":5432 \
          pgvector/pgvector:pg16 >/dev/null || {
            err "Failed to create database container"
            exit 1
          }
      fi
    fi

    # Wait for container to accept connections
    dim "Waiting for database..."
    launch_log "waiting for database readiness"
    local retries=0
    while ! run_with_timeout 5 "$DOCKER_BIN" exec illo-db pg_isready -U "$db_user" &>/dev/null; do
      retries=$((retries + 1))
      if [ $retries -gt 30 ]; then
        err "Database did not become ready in time"
        exit 1
      fi
      sleep 1
    done
    fi
  fi
  dim "Database ready"
  launch_log "database ready"
  export DB_HOST="$db_host"
  export DB_PORT="$db_port"
  export DB_NAME="$db_name"
  export DB_USER="$db_user"
  export DB_PASSWORD="$db_pass"

  if psql_available; then
    export PGPASSWORD="$db_pass"
    local vector_available
    vector_available=$(
      run_psql_no_prompt -h "$db_host" -p "$db_port" -U "$db_user" -d "$db_name" \
        -tAc "SELECT 1 FROM pg_available_extensions WHERE name = 'vector'" \
        2>/dev/null || true
    )
    unset PGPASSWORD
    if [ "$vector_available" != "1" ]; then
      err "Postgres at $db_host:$db_port is missing the pgvector extension"
      err "Install pgvector for this Postgres, or stop it and let the launcher start the pgvector Docker database"
      exit 1
    fi
  fi

  # Run migrations (from project root where alembic.ini lives)
  if "$ROOT/venv/bin/python3" -c "import alembic" &>/dev/null; then
    dim "Running database migrations..."
    launch_log "running database migrations"
    cd "$ROOT"
    "$ROOT/venv/bin/python3" -m alembic upgrade head || {
      err "Migrations failed — check brain/platform/db/alembic for errors"
      exit 1
    }
  fi
}

