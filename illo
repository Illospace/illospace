}

should_prefetch_embedding_model() {
  is_truthy "${ILLO_DOWNLOAD_GPU_MODELS:-0}" && return 0
  [ "${EMBEDDING_BACKEND:-api}" = "gpu" ]
}

should_prefetch_llm_model() {
  is_truthy "${ILLO_DOWNLOAD_GPU_MODELS:-0}" && return 0
  [ -n "${LLM_MODEL_PATH:-}" ] || [ -n "${LLM_MODEL:-}" ]
}

# ── Setup (idempotent) ─────────────────────────────────────

setup() {
  echo ""
  echo -e "${BOLD}Setting up Illospace...${NC}"
  echo ""

  # 1. Python virtual environment
  if [ ! -d "venv" ]; then
    info "Creating Python virtual environment..."
    python3 -m venv venv || {
      err "Failed to create venv — try: sudo apt install python3-venv python3-full"
      exit 1
    }
  fi
  source venv/bin/activate

  # 2. Python dependencies (always sync to catch updates)
  info "Installing Python dependencies..."

  # Install PyTorch with correct CUDA support BEFORE requirements.txt
  # (sentence-transformers pulls torch — we want the GPU-compatible version)
  if command -v nvidia-smi &>/dev/null; then
    local cuda_ver
    cuda_ver=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1)
    if [ -n "$cuda_ver" ]; then
      # Detect CUDA version from nvidia-smi output
      local cuda_major
      cuda_major=$(nvidia-smi 2>/dev/null | grep -oP 'CUDA Version: \K[0-9]+\.[0-9]+' | head -1)
      if [ -n "$cuda_major" ]; then
        local cuda_tag="${cuda_major//./}"  # "12.8" → "128"
        info "Detected CUDA $cuda_major — installing PyTorch with cu${cuda_tag} support..."
        # Try exact match first, fall back to cu124 (widely supported)
        "$ROOT/venv/bin/pip" install -q torch --index-url "https://download.pytorch.org/whl/cu${cuda_tag}" 2>/dev/null || \
        "$ROOT/venv/bin/pip" install -q torch --index-url "https://download.pytorch.org/whl/cu124" 2>/dev/null || \
        warn "Could not install CUDA-compatible PyTorch — GPU embeddings may not work"
      fi
    fi
  fi

  "$ROOT/venv/bin/pip" install -q -r requirements.txt

  # 2a. PredictRLM runtime
  ensure_deno_runtime

  # 2b. Browser runtime for thought browsing
  ensure_browser_runtime "$ROOT/venv/bin/python3" || {
    err "Browser runtime setup failed — check Chrome for Testing install or set ILLO_BROWSER_CHROME_BIN"
    exit 1
  }

  # 2c. Environment values. Source this before optional GPU model decisions
  # so the default API embedding setup can reach the System tab without
  # pre-downloading large local models.
  source_env
  apply_uninstall_database_env_reset
  if [ ! -f ".env" ]; then
    dim "No .env found — using shell environment and built-in development defaults"
    dim "Optional: copy .env.example to .env for local file-based overrides"
  else
    dim ".env already exists"
  fi
  ensure_runtime_secrets

  # 2d. Download GPU models if explicitly requested
  if command -v nvidia-smi &>/dev/null; then
    local models_dir="$ROOT/models"
    local prefetched_any=0
    mkdir -p "$models_dir"

    if should_prefetch_embedding_model; then
      prefetched_any=1
      if [ ! -d "$models_dir/qwen3-embedding-8b" ] || [ -z "$(ls -A "$models_dir/qwen3-embedding-8b" 2>/dev/null)" ]; then
        info "Downloading embedding model (Qwen3-Embedding-8B)..."
        hf_download Qwen/Qwen3-Embedding-8B "$models_dir/qwen3-embedding-8b" || \
          warn "Failed to download embedding model — GPU embeddings won't work"
      else
        dim "Embedding model already downloaded"
      fi
    fi

    if should_prefetch_llm_model; then
      prefetched_any=1
      if [ ! -d "$models_dir/qwen3.5-4b" ] || [ -z "$(ls -A "$models_dir/qwen3.5-4b" 2>/dev/null)" ]; then
        info "Downloading LLM model (Qwen3.5-4B)..."
        hf_download Qwen/Qwen3.5-4B "$models_dir/qwen3.5-4b" || \
          warn "Failed to download LLM model — GPU LLM won't work (Ollama fallback still available)"
      else
        dim "LLM model already downloaded"
      fi
    fi

    if [ $prefetched_any -eq 0 ]; then
      dim "Skipping GPU model pre-download; configure embeddings in System, or set ILLO_DOWNLOAD_GPU_MODELS=1 to prefetch"
    fi
  fi

  # 3. Frontend dependencies
  sync_frontend_dependencies

  # 4. Database
  ensure_db

  echo ""
  info "Setup complete."
  echo ""
}

needs_setup() {
  [ ! -d "venv" ] && return 0
  [ ! -d "frontend/node_modules" ] && return 0
  return 1
}

# ── Run ────────────────────────────────────────────────────

run_dev() {
  if [ -f "venv/bin/activate" ]; then
    source venv/bin/activate
  else
    err "No venv found — run ./illo setup first"
    exit 1
  fi
  source_env
  export ILLO_ENV="${ILLO_ENV:-development}"
  ensure_runtime_secrets

  # Local dev should consume the queue inline unless the user explicitly
  # turned it off. This keeps ./illo self-contained for laptop testing.
  if [ -z "${CORTEX_INLINE_DISPATCHER:-}" ]; then
    export CORTEX_INLINE_DISPATCHER=1
    dim "CORTEX_INLINE_DISPATCHER not set — enabling inline dispatcher for local dev"
  fi

  # The API process started by ./illo already launches the dispatcher.
  # Stop any lingering systemd services so a stale worker cannot consume
  # dispatches from another checkout.
  log_phase "development: stop conflicting user services"
  stop_conflicting_services

  # ── Nuke all stale illo processes ─────────────────────────────
  # Kill GPU workers (hold VRAM), GPU server, uvicorn + reload children
  log_phase "development: kill stale local processes"
  local stale_pids
  stale_pids=$(pgrep -f "brain[./]gpu" 2>/dev/null || true)
  [ -n "$stale_pids" ] && echo "$stale_pids" | xargs kill -9 2>/dev/null || true
  stale_pids=$(pgrep -f "uvicorn.*brain\.api" 2>/dev/null || true)
  [ -n "$stale_pids" ] && echo "$stale_pids" | xargs kill -9 2>/dev/null || true
  stale_pids=$(pgrep -f "npm.*dev.*5173" 2>/dev/null || true)
  [ -n "$stale_pids" ] && echo "$stale_pids" | xargs kill -9 2>/dev/null || true
  sleep 1

  # ── Kill anything still on our ports ────────────────────────
  log_phase "development: free runtime ports"
  for port in 8000 5173 9800; do
    stop_port_processes "$port" "development runtime"
  done

  # Wait until ports are free (up to 5s each)
  for port in 8000 9800; do
    local wait_count=0
    while port_process_pids "$port" | grep -q '[0-9]' && [ $wait_count -lt 10 ]; do
      sleep 0.5
      wait_count=$((wait_count + 1))
    done
    if port_process_pids "$port" | grep -q '[0-9]'; then
      err "Port $port is still in use after stopping known Illo processes."
      describe_pids "$(port_process_pids "$port")" >&2
      err "Stop that process or set ILLO_FORCE_KILL_PORTS=1 if you want ./illo to kill it."
      exit 1
    fi
  done

  # Ensure DB is running even if setup was skipped
  log_phase "development: ensure database"
  ensure_db

  # Sync Python deps in case requirements changed since last setup
  log_phase "development: sync Python dependencies"
  "$ROOT/venv/bin/pip" install -q -r requirements.txt 2>/dev/null
  log_phase "development: ensure Deno runtime"
  ensure_deno_runtime
  log_phase "development: ensure browser runtime"
  ensure_browser_runtime "$ROOT/venv/bin/python3" || {
    err "Browser runtime setup failed — check Chrome for Testing install or set ILLO_BROWSER_CHROME_BIN"
    exit 1
  }
  log_phase "development: sync frontend dependencies"
  sync_frontend_dependencies

  # Offload Ollama models to free VRAM for GPU server workers
  log_phase "development: prepare GPU/runtime environment"
  offload_ollama_models
  configure_gpu_environment

  # Start GPU server (embeddings + local LLM) in background
  log_phase "development: start GPU server"
  GPU_PID=""
  (
    cd "$ROOT"
    PYTHONPATH="$ROOT" "$ROOT/venv/bin/python3" -m brain.platform.gpu >> /tmp/illo-gpu-server.log 2>&1
  ) &
  GPU_PID=$!
  # Quick check: did it crash immediately?
  sleep 1
  if kill -0 $GPU_PID 2>/dev/null; then
    info "GPU server started (pid $GPU_PID)"
    # Wait for it to be ready (up to 15s)
    local gpu_ready=0
    for i in $(seq 1 15); do
      if curl --max-time 2 -sf http://127.0.0.1:9800/health >/dev/null 2>&1; then
        gpu_ready=1
        break
      fi
      sleep 1
    done
    if [ $gpu_ready -eq 1 ]; then
      info "GPU server ready"
    else
      warn "GPU server started but not ready yet (may still be loading models)"
    fi
  else
    warn "GPU server failed to start — embeddings/memory will not work"
    warn "Check /tmp/illo-gpu-server.log for errors"
    GPU_PID=""
  fi

  echo ""
  echo -e "${BOLD}Illospace${NC}"
  echo -e "  API:       ${GREEN}http://localhost:8000${NC}  ${DIM}(docs at /api/docs)${NC}"
  echo -e "  Dashboard: ${GREEN}http://localhost:5173${NC}"
  if [ -n "$GPU_PID" ]; then
    echo -e "  GPU:       ${GREEN}http://localhost:9800${NC}  ${DIM}(embeddings + LLM)${NC}"
  else
    echo -e "  GPU:       ${RED}not running${NC}  ${DIM}(check /tmp/illo-gpu-server.log)${NC}"
  fi
  echo -e "  API log:   ${GREEN}/tmp/illo-api.log${NC}"
  echo -e "  ${DIM}Press Ctrl+C to stop${NC}"
  echo ""

  # Start frontend dev server in background (strict port to avoid drift)
  log_phase "development: start frontend dev server"
  cd frontend && npm run dev -- --host --port 5173 --strict-port 2>/dev/null &
  FRONTEND_PID=$!
  cd "$ROOT"

  # Cleanup on exit — kill process groups to include worker subprocesses
  cleanup() {
    echo ""
    dim "Shutting down..."
    # Kill GPU server + its worker subprocesses (entire process group)
    if [ -n "$GPU_PID" ] && kill -0 "$GPU_PID" 2>/dev/null; then
      kill -- -"$GPU_PID" 2>/dev/null || kill "$GPU_PID" 2>/dev/null
    fi
    # Kill any remaining GPU workers
    pkill -f "brain\.gpu\.workers\." 2>/dev/null || true
    kill "$FRONTEND_PID" 2>/dev/null
    exit 0
  }
  trap cleanup INT TERM

  # Final port check — something may have re-bound 8000 during GPU/frontend startup
  log_phase "development: final API port check"
  local api_pids
  api_pids=$(lsof -ti tcp:8000 2>/dev/null || true)
  if [ -n "$api_pids" ]; then
    stop_port_processes 8000 "development API"
    sleep 1
  fi

  # Start API (foreground)
  log_phase "development: start API server"
  : > /tmp/illo-api.log
  PYTHONUNBUFFERED=1 "$ROOT/venv/bin/uvicorn" brain.app.api.main:app --port 8000 --host 0.0.0.0 \
    2>&1 | tee -a /tmp/illo-api.log
}

run_prod() {
  if [ -f "venv/bin/activate" ]; then
    source venv/bin/activate
  else
    err "No venv found — run ./illo setup first"
    exit 1
  fi
  source_env
  export ILLO_ENV="${ILLO_ENV:-production}"
  local api_bind_host="${ILLO_API_HOST:-127.0.0.1}"
  ensure_runtime_secrets
  local cortex_inline_defaulted=0
  # Production-safe start keeps API/dashboard restarts independent from
  # AgentRun workers. Use the standalone cortex-worker service for queue
  # ownership; local self-contained queue consumption belongs to ./illo dev.
  if [ -z "${CORTEX_INLINE_DISPATCHER:-}" ]; then
    export CORTEX_INLINE_DISPATCHER=0
    cortex_inline_defaulted=1
    dim "CORTEX_INLINE_DISPATCHER not set — leaving AgentRuns to the standalone worker"
  fi
  log_phase "production: stop conflicting API services"
  stop_conflicting_services "illo-dashboard" "illo-api"
  log_phase "production: ensure database"
  ensure_db

  # Sync Python deps in case requirements changed
  log_phase "production: sync Python dependencies"
  "$ROOT/venv/bin/pip" install -q -r requirements.txt 2>/dev/null
  log_phase "production: ensure Deno runtime"
  ensure_deno_runtime
  log_phase "production: ensure browser runtime"
  ensure_browser_runtime "$ROOT/venv/bin/python3" || {
    err "Browser runtime setup failed — check Chrome for Testing install or set ILLO_BROWSER_CHROME_BIN"
    exit 1
  }
  log_phase "production: sync frontend dependencies"
  sync_frontend_dependencies

  log_phase "production: prepare GPU/runtime environment"
  local active_runs_for_runtime
  active_runs_for_runtime="$(active_agent_run_count || echo unknown)"
  if [ "$active_runs_for_runtime" = "0" ]; then
    offload_ollama_models
  else
    dim "Skipping Ollama offload while $active_runs_for_runtime AgentRun(s) are active"
  fi
  configure_gpu_environment

  GPU_PID=""
  local should_start_embedder=0
  if is_truthy "${ILLO_START_EMBEDDER:-0}"; then
    should_start_embedder=1
  elif [ "${EMBEDDING_BACKEND:-api}" = "gpu" ]; then
    should_start_embedder=1
    dim "EMBEDDING_BACKEND=gpu - starting local GPU embedder"
  fi

  if [ "$should_start_embedder" = "1" ]; then
    log_phase "production: start GPU server"
    if lsof -ti tcp:9800 >/dev/null 2>&1; then
      dim "GPU server already bound on :9800; leaving it alone"
    else
      (
        cd "$ROOT"
        PYTHONPATH="$ROOT" "$ROOT/venv/bin/python3" -m brain.platform.gpu >> /tmp/illo-gpu-server.log 2>&1
      ) &
      GPU_PID=$!
      sleep 1
      if kill -0 $GPU_PID 2>/dev/null; then
        info "GPU server started (pid $GPU_PID)"
      else
        warn "GPU server failed to start — check /tmp/illo-gpu-server.log"
        GPU_PID=""
      fi
    fi
  else
    dim "Leaving GPU/embedder services untouched (set EMBEDDING_BACKEND=gpu or ILLO_START_EMBEDDER=1 to start it here)"
    unload_unused_embedding_worker
  fi

  info "Building frontend..."
  log_phase "production: build frontend"
  (cd frontend && npm run build) || warn "Frontend build failed"
  cd "$ROOT"

  log_phase "production: ensure worker services"
  if ! ensure_production_user_services; then
    if [ "$cortex_inline_defaulted" = "1" ]; then
      export CORTEX_INLINE_DISPATCHER=1
      warn "Standalone worker service is unavailable; using inline AgentRun dispatcher for this launch"
    else
      warn "Standalone worker service is unavailable and CORTEX_INLINE_DISPATCHER was set explicitly"
    fi
  fi

  echo ""
  echo -e "${BOLD}Illospace${NC} ${DIM}(production)${NC}"
  echo -e "  App: ${GREEN}http://localhost:8000${NC}"
  if [ "$api_bind_host" = "127.0.0.1" ] || [ "$api_bind_host" = "localhost" ]; then
    echo -e "  Bind: ${GREEN}${api_bind_host}:8000${NC} ${DIM}(private to this host)${NC}"
  else
    echo -e "  Bind: ${YELLOW}${api_bind_host}:8000${NC} ${DIM}(secure with your firewall, tunnel, or reverse proxy)${NC}"
  fi
  if [ -n "$GPU_PID" ]; then
    echo -e "  GPU: ${GREEN}http://localhost:9800${NC}"
  elif lsof -ti tcp:9800 >/dev/null 2>&1; then
    echo -e "  GPU: ${GREEN}http://localhost:9800${NC} ${DIM}(existing service)${NC}"
  else
    echo -e "  GPU: ${RED}not running${NC}"
  fi
  echo -e "  API log: ${GREEN}/tmp/illo-api.log${NC}"
  echo ""

  cleanup_prod() {
    dim "Shutting down..."
    if [ -n "$GPU_PID" ] && kill -0 "$GPU_PID" 2>/dev/null; then
      kill -- -"$GPU_PID" 2>/dev/null || kill "$GPU_PID" 2>/dev/null
      pkill -f "brain\.gpu\.workers\." 2>/dev/null || true
    fi
    exit 0
  }
  trap cleanup_prod INT TERM
  trap '' HUP

  cd "$ROOT"
  # Final port check
  log_phase "production: final API port check"
  local api_pids
  api_pids=$(lsof -ti tcp:8000 2>/dev/null || true)
  if [ -n "$api_pids" ]; then
    guard_api_port_kill "$api_pids"
    stop_port_processes 8000 "production API"
    sleep 1
  fi
  : > /tmp/illo-api.log
  log_phase "production: start API server"
  PYTHONUNBUFFERED=1 "$ROOT/venv/bin/uvicorn" brain.app.api.main:app --host "$api_bind_host" --port 8000 \
    2>&1 | tee -a /tmp/illo-api.log
}

# ── Uninstall / local reset ────────────────────────────────

uninstall_usage() {
  echo ""
  echo -e "${BOLD}Usage:${NC} ./illo uninstall [options]"
  echo ""
  echo "Removes local Illo runtime/install state so this checkout can be set up from scratch."
  echo ""
  echo -e "  ${GREEN}-y, --yes${NC}       Skip confirmation"
  echo -e "  ${GREEN}--keep-db${NC}       Keep local database runtimes/containers"
  echo -e "  ${GREEN}--keep-config${NC}   Keep .env and ops/cron/env.conf"
  echo -e "  ${GREEN}--keep-private${NC}  Keep .illo private runtime state"
  echo -e "  ${GREEN}--keep-models${NC}   Keep downloaded local models"
  echo -e "  ${GREEN}--dry-run${NC}       Show what would be removed"
  echo ""
}

remove_path_if_present() {
  local path="$1"
  local dry_run="$2"
  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    return 0
  fi
  if [ "$dry_run" = "1" ]; then
    echo "Would remove: $path"
    return 0
  fi
  rm -rf "$path"
  dim "Removed $path"
}

kill_pids() {
  local pids="$1"
  local label="$2"
  local dry_run="$3"
  if [ -z "$pids" ]; then
    return 0
  fi
  if [ "$dry_run" = "1" ]; then
    echo "Would stop $label pid(s): $pids"
    return 0
  fi
  echo "$pids" | tr ' ' '\n' | sort -u | xargs kill -TERM 2>/dev/null || true
  sleep 1
  echo "$pids" | tr ' ' '\n' | sort -u | xargs kill -KILL 2>/dev/null || true
  dim "Stopped $label pid(s): $pids"
}

stop_local_processes_for_uninstall() {
  local dry_run="$1"
  local pids

  if [ "$dry_run" = "1" ]; then
    echo "Would stop known Illo systemd user services if installed"
  else
    stop_conflicting_services || true
  fi

  pids="$(pgrep -f "uvicorn.*brain\.app\.api\.main" 2>/dev/null | tr '\n' ' ' || true)"
  kill_pids "$pids" "Illo API" "$dry_run"

  pids="$(pgrep -f "brain\.platform\.gpu" 2>/dev/null | tr '\n' ' ' || true)"
  kill_pids "$pids" "Illo GPU server" "$dry_run"

  pids="$(pgrep -f "brain\.gpu\.workers\." 2>/dev/null | tr '\n' ' ' || true)"
  kill_pids "$pids" "Illo GPU worker" "$dry_run"

  pids="$(pgrep -f "npm.*dev.*5173" 2>/dev/null | tr '\n' ' ' || true)"
  kill_pids "$pids" "Illo frontend" "$dry_run"

  local port
  for port in 8000 5173 9800; do
    pids="$(port_process_pids "$port")"
    kill_pids "$pids" "process on port $port" "$dry_run"
  done
}

remove_illo_db_containers() {
  local dry_run="$1"
  local names=("illo-db" "illo-brain-db")
  if [ -n "${ILLO_DB_CONTAINER:-}" ]; then
    names=("$ILLO_DB_CONTAINER" "${names[@]}")
  fi

  if ! docker_available; then
    dim "Docker/Podman is not available — skipping container database removal"
    return 0
  fi

  local seen="" name existing
  for name in "${names[@]}"; do
    case " $seen " in
      *" $name "*) continue ;;
    esac
    seen="$seen $name"
    existing="$(run_with_timeout 5 "$DOCKER_BIN" ps -a --format '{{.Names}}' 2>/dev/null | grep -x "$name" || true)"
    if [ -z "$existing" ]; then
      continue
    fi
    if [ "$dry_run" = "1" ]; then
      echo "Would remove database container and volumes: $name"
    else
      run_with_timeout 30 "$DOCKER_BIN" rm -f -v "$name" >/dev/null || {
        warn "Failed to remove database container $name"
        continue
      }
      dim "Removed database container and volumes: $name"
    fi
  done
}

uninstall() {
  local assume_yes=0
  local keep_db=0
  local keep_config=0
  local keep_private=0
  local keep_models=0
  local dry_run=0

  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes) assume_yes=1 ;;
      --keep-db) keep_db=1 ;;
      --keep-config) keep_config=1 ;;
      --keep-private) keep_private=1 ;;
      --keep-models) keep_models=1 ;;
      --dry-run) dry_run=1 ;;
      -h|--help) uninstall_usage; return 0 ;;
      *)
        err "Unknown uninstall option: $1"
        uninstall_usage
        exit 1
        ;;
    esac
    shift
  done

  local inherited_db_vars
  inherited_db_vars="$(database_env_var_names)"
  source_env

  echo ""
  echo -e "${BOLD}Uninstall Illo local runtime${NC}"
  echo ""
  echo "This keeps the git checkout, but removes local install/runtime state under:"
  echo "  $ROOT"
  echo ""
  echo "It will stop known Illo services/processes and remove generated dependencies."
  if [ $keep_db -eq 0 ]; then
    echo "It will delete the Illo repo-local PostgreSQL runtime and Docker/Podman database container(s)."
  fi
  if [ $keep_config -eq 0 ]; then
    echo "It will delete local config files: .env and ops/cron/env.conf."
  fi
  if [ $keep_private -eq 0 ]; then
    echo "It will delete private runtime state under .illo."
  fi
  echo ""

  if [ $assume_yes -eq 0 ] && [ $dry_run -eq 0 ]; then
    local answer
    read -r -p "Type 'uninstall' to continue: " answer
    if [ "$answer" != "uninstall" ]; then
      dim "Uninstall cancelled."
      return 0
    fi
  fi

  stop_local_processes_for_uninstall "$dry_run"
  if [ $keep_db -eq 0 ]; then
    stop_managed_postgres_for_uninstall "$dry_run"
  fi

  if [ $keep_db -eq 0 ]; then
    remove_illo_db_containers "$dry_run"
  fi

  remove_path_if_present "$ROOT/venv" "$dry_run"
  if [ $keep_db -eq 0 ]; then
    remove_path_if_present "$ROOT/.runtime" "$dry_run"
  else
    remove_path_if_present "$LOCAL_DENO_INSTALL" "$dry_run"
    remove_path_if_present "$LOCAL_BROWSER_RUNTIME_DIR" "$dry_run"
  fi
  remove_path_if_present "$ROOT/frontend/node_modules" "$dry_run"
  remove_path_if_present "$ROOT/frontend/.svelte-kit" "$dry_run"
  remove_path_if_present "$ROOT/frontend/build" "$dry_run"
  remove_path_if_present "$ROOT/.pytest_cache" "$dry_run"
  remove_path_if_present "$ROOT/logs" "$dry_run"
  remove_path_if_present "/tmp/illo-api.log" "$dry_run"
  remove_path_if_present "/tmp/illo-gpu-server.log" "$dry_run"
  remove_path_if_present "/tmp/illo-deno-install.log" "$dry_run"

  if [ $keep_models -eq 0 ]; then
    remove_path_if_present "$ROOT/models" "$dry_run"
  fi
  if [ $keep_private -eq 0 ]; then
    remove_path_if_present "$ROOT/.illo" "$dry_run"
  fi
  if [ $keep_config -eq 0 ]; then
    remove_path_if_present "$ROOT/.env" "$dry_run"
    remove_path_if_present "$ROOT/ops/cron/env.conf" "$dry_run"
    record_uninstall_database_env_reset "$dry_run"
  fi

  if [ -n "$inherited_db_vars" ]; then
    warn "Your shell still has database variables: $inherited_db_vars"
    if [ $keep_config -eq 0 ]; then
      dim "./illo cannot unset variables in the parent shell, so the next setup will ignore them once."
    else
      warn "Because --keep-config was used, those variables may still affect the next setup."
    fi
  fi

  if [ $dry_run -eq 1 ]; then
    info "Uninstall dry run complete."
  else
    info "Uninstall complete. Run ./illo setup to start from scratch."
  fi
}

# ── Compose deployment CLI ─────────────────────────────────

deploy_compose_env_file() {
  echo "${ILLO_COMPOSE_ENV_FILE:-$ROOT/deploy/compose/.env}"
}

deploy_compose_file() {
  echo "$ROOT/deploy/compose/docker-compose.yml"
}

deploy_ensure_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    err "docker not found — install Docker Engine with Docker Compose v2"
    return 1
  fi
  if ! docker compose version >/dev/null 2>&1; then
    err "docker compose is unavailable — install Docker Compose v2"
    return 1
  fi
  local docker_info_output
  if ! docker_info_output="$(docker info 2>&1 >/dev/null)"; then
    err "Docker CLI is installed, but the Docker daemon/socket is not reachable."
    if [ -n "$docker_info_output" ]; then
      dim "docker info said:"
      printf '%s\n' "$docker_info_output" | sed 's/^/  /' >&2
    fi
    dim "Try: docker info"
    dim "If the service is stopped: sudo systemctl enable --now docker"
    dim "If you see permission denied: sudo usermod -aG docker \$USER, then log out and back in."
    return 1
  fi
}

deploy_compose() {
  docker compose --env-file "$(deploy_compose_env_file)" -f "$(deploy_compose_file)" "$@"
}

deploy_env_value() {
  local key="$1"
  local env_file value
  env_file="$(deploy_compose_env_file)"
  value="$(
    python3 - "$env_file" "$key" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
key = sys.argv[2]
if not path.exists():
    sys.exit(0)
pattern = re.compile(rf"^{re.escape(key)}=(.*)$")
for line in path.read_text(encoding="utf-8").splitlines():
    match = pattern.match(line.strip())
    if match:
        value = match.group(1).strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
            value = value[1:-1]
        print(value)
        break
PY
  )"
  printf '%s' "$value"
}

deploy_require_env_file() {
  local env_file
  env_file="$(deploy_compose_env_file)"
  if [ ! -f "$env_file" ]; then
    err "Missing $env_file"
    dim "Run: ./illo deploy init"
    return 1
  fi
}

deploy_ensure_env_file() {
  if [ -f "$(deploy_compose_env_file)" ]; then
    return 0
  fi

  dim "Creating Compose env file with generated secrets..."
  "$ROOT/deploy/scripts/init-secrets.sh" --env-file "$(deploy_compose_env_file)" --no-next
}

deploy_usage() {
  echo ""
  echo -e "${BOLD}Usage:${NC} ./illo deploy <command>"
  echo ""
  echo -e "  ${GREEN}init${NC}       Create deploy/compose/.env and generate secrets"
  echo -e "  ${GREEN}up${NC}         Pull/build images, start the Compose stack, then run doctor"
  echo -e "  ${GREEN}doctor${NC}     Validate server config and running stack health"
  echo -e "  ${GREEN}status${NC}     Show Compose service status"
  echo -e "  ${GREEN}logs${NC}       Show Compose logs (pass -f to follow, service names to filter)"
  echo -e "  ${GREEN}backup${NC}     Write a Postgres backup dump"
  echo -e "  ${GREEN}restore${NC}    Restore a Postgres backup dump"
  echo -e "  ${GREEN}upgrade${NC}    Pull/build, migrate, restart, and run doctor"
  echo -e "  ${GREEN}down${NC}       Stop the Compose stack"
  echo ""
}

deploy_up() {
  local build=0
  local pull=1
  local doctor=1

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --build)
        build=1
        shift
        ;;
      --no-pull)
        pull=0
        shift
        ;;
      --skip-doctor)
        doctor=0
        shift
        ;;
      -h|--help)
        echo "Usage: ./illo deploy up [--build] [--no-pull] [--skip-doctor]"
        return 0
        ;;
      *)
        err "Unknown deploy up option: $1"
        return 2
        ;;
    esac
  done

  deploy_ensure_env_file || return 1
  deploy_ensure_docker || return 1

  if [ "$pull" = "1" ]; then
    if ! deploy_compose pull; then
      warn "Image pull failed; building API and web images locally instead."
      build=1
    fi
  fi
  if [ "$build" = "1" ]; then
    deploy_compose build api web || return 1
  fi
  deploy_compose up -d || return 1
  if [ "$doctor" = "1" ]; then
    "$ROOT/deploy/scripts/doctor.sh"
  fi
  local web_port
  web_port="$(deploy_env_value ILLO_WEB_PORT)"
  web_port="${web_port:-8080}"
  dim ""
  dim "Illospace is listening privately on the server at 127.0.0.1:${web_port}."
  dim "From your workstation, run:"
  dim "  ssh -L ${web_port}:127.0.0.1:${web_port} <ssh-user>@<server>"
  dim "Then open: http://localhost:${web_port}"
  dim "For team-wide access, put your own reverse proxy, VPN, or private network in front of this loopback port."
}

deploy_command() {
  local subcommand="${1:-help}"
  shift || true

  case "$subcommand" in
    init)
      "$ROOT/deploy/scripts/init-secrets.sh" "$@"
      ;;
    up)
      deploy_up "$@"
      ;;
    doctor)
      "$ROOT/deploy/scripts/doctor.sh" "$@"
      ;;
    status|ps)
      deploy_require_env_file || return 1
      deploy_ensure_docker || return 1
      deploy_compose ps "$@"
      ;;
    logs)
      deploy_require_env_file || return 1
      deploy_ensure_docker || return 1
      deploy_compose logs "$@"
      ;;
    backup)
      "$ROOT/deploy/scripts/backup.sh" "$@"
      ;;
    restore)
      "$ROOT/deploy/scripts/restore.sh" "$@"
      ;;
    upgrade)
      "$ROOT/deploy/scripts/upgrade.sh" "$@"
      ;;
    down)
      deploy_require_env_file || return 1
      deploy_ensure_docker || return 1
      deploy_compose down "$@"
      ;;
    help|-h|--help)
      deploy_usage
      ;;
    *)
      err "Unknown deploy command: $subcommand"
      deploy_usage
      return 1
      ;;
  esac
}

# ── Self-update CLI ────────────────────────────────────────

update_usage() {
  echo ""
  echo -e "${BOLD}Usage:${NC} ./illo update [--mode auto|native|compose]"
  echo ""
  echo "Fetch origin/main and update the running server without interrupting active AgentRuns."
  echo ""
  echo "Modes:"
  echo -e "  ${GREEN}auto${NC}      Prefer native/systemd when active, otherwise Compose when a stack is present"
  echo -e "  ${GREEN}native${NC}    Run ops/deploy.sh, which drains cortex-worker while AgentRuns are active"
  echo -e "  ${GREEN}compose${NC}   Fast-forward to origin/main, rebuild images, migrate, and restart Compose"
  echo ""
}

update_git_sync_main() {
  echo "=== Syncing checkout to origin/main ==="
  git fetch origin main
  git checkout main
  git pull --ff-only origin main
}

update_native_services_active() {
  systemd_user_ready || return 1
  run_logged_timeout 5 systemctl --user is-active --quiet illo-api.service >/dev/null 2>&1 && return 0
  run_logged_timeout 5 systemctl --user is-active --quiet cortex-worker.service >/dev/null 2>&1 && return 0
  return 1
}

update_compose_stack_present() {
  [ -f "$(deploy_compose_env_file)" ] || return 1
  command -v docker >/dev/null 2>&1 || return 1
  docker compose version >/dev/null 2>&1 || return 1
  deploy_compose ps -q api >/dev/null 2>&1 || return 1
  [ -n "$(deploy_compose ps -q api 2>/dev/null || true)" ]
}

update_detect_mode() {
  if update_native_services_active; then
    echo "native"
    return 0
  fi
  if update_compose_stack_present; then
    echo "compose"
    return 0
  fi
  echo "local"
}

update_command() {
  local mode="${ILLO_UPDATE_MODE:-${ILLO_SELF_UPDATE_MODE:-auto}}"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --mode)
        mode="${2:?--mode requires a value}"
        shift 2
        ;;
      -h|--help)
        update_usage
        return 0
        ;;
      *)
        err "Unknown update option: $1"
        update_usage
        return 2
        ;;
    esac
  done

  case "$mode" in
    auto)
      mode="$(update_detect_mode)"
      ;;
    native|systemd)
      mode="native"
      ;;
    compose|docker)
      mode="compose"
      ;;
    local|dev)
      mode="local"
      ;;
    *)
      err "Unknown update mode: $mode"
      update_usage
      return 2
      ;;
  esac

  case "$mode" in
    native)
      dim "Update mode: native/systemd"
      exec "$ROOT/ops/deploy.sh"
      ;;
    compose)
      dim "Update mode: Docker Compose"
      update_git_sync_main || return 1
      deploy_command upgrade --build --no-pull
      ;;
    local)
      err "Self-update is not enabled for local/dev runs."
      dim "Run git pull manually for local development, or set ILLO_UPDATE_MODE=native|compose when this checkout owns a server."
      return 1
      ;;
  esac
}

# ── CLI ────────────────────────────────────────────────────

usage() {
  echo ""
  echo -e "${BOLD}Usage:${NC} ./illo [command]"
  echo ""
  echo -e "  ${GREEN}(no args)${NC}    Start native server mode (setup first if needed)"
  echo -e "  ${GREEN}dev${NC}          Start development mode with frontend hot reload"
  echo -e "  ${GREEN}setup${NC}        Run setup only"
  echo -e "  ${GREEN}deploy${NC}       Manage the recommended Compose team-server deploy"
  echo -e "  ${GREEN}update${NC}       Update a running server from origin/main"
  echo -e "  ${GREEN}doctor${NC}       Validate local configuration"
  echo -e "  ${GREEN}uninstall${NC}    Remove local runtime, config, and Illo Docker DB"
  echo -e "  ${GREEN}test${NC}         Run tests"
  echo ""
}

begin_launch_log "$*"

case "${1:-}" in
  setup)
    check_prereqs
    setup
    ;;
  dev)
    check_prereqs
    needs_setup && setup
    run_dev
    ;;
  deploy)
    deploy_command "${@:2}"
    ;;
  update)
    update_command "${@:2}"
    ;;
  doctor)
    check_prereqs
    source_env
    if [ -x "$ROOT/venv/bin/python3" ]; then
      "$ROOT/venv/bin/python3" -m brain.app.cli.config_doctor --root "$ROOT" "${@:2}"
    else
      python3 -m brain.app.cli.config_doctor --root "$ROOT" "${@:2}"
    fi
    ;;
  uninstall)
    uninstall "${@:2}"
    ;;
  test)
    [ -f "venv/bin/activate" ] && source venv/bin/activate
    "$ROOT/venv/bin/python3" -m pytest tests/ -m "not requires_db" -q "${@:2}"
    ;;
  help|-h|--help)
    usage
    ;;
  "")
    check_prereqs
    needs_setup && setup
    run_prod
    ;;
  *)
    err "Unknown command: $1"
    usage
    exit 1
    ;;
esac
