#!/usr/bin/env bash

if [ -z "${BASH_VERSION:-}" ] || [ "${BASH:-}" = "/bin/sh" ]; then
  exec /usr/bin/env bash "$0" "$@"
fi

# illo — single entry point for Illospace
# First run: sets everything up. Every run after: starts the app.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"
DOCKER_BIN=""
DOCKER_START_ATTEMPTED=0
LAUNCH_LOG_DEFAULT="$ROOT/logs/illo-launcher.log"
UNINSTALL_DB_ENV_RESET_MARKER="$ROOT/.illo-uninstall-reset-db-env"
DATABASE_ENV_VARS=(DATABASE_URL DB_URL BRAIN_DB_URL DB_HOST DB_PORT DB_NAME DB_USER DB_PASSWORD)
LOCAL_POSTGRES_RUNTIME_DIR="${ILLO_LOCAL_POSTGRES_RUNTIME_DIR:-$ROOT/.runtime/postgres}"
LOCAL_POSTGRES_DATA_DIR="$LOCAL_POSTGRES_RUNTIME_DIR/data"
LOCAL_POSTGRES_LOG="$LOCAL_POSTGRES_RUNTIME_DIR/postgres.log"
LOCAL_POSTGRES_PORT_FILE="$LOCAL_POSTGRES_RUNTIME_DIR/port"
MANAGED_POSTGRES_PORT=""

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

info()  { echo -e "${GREEN}$1${NC}"; }
warn()  { echo -e "${YELLOW}$1${NC}"; }
err()   { echo -e "${RED}$1${NC}"; }
dim()   { echo -e "${DIM}$1${NC}"; }

launch_log_path() {
  echo "${ILLO_LAUNCH_LOG:-$LAUNCH_LOG_DEFAULT}"
}

ensure_launch_log_dir() {
  local log_path
  log_path="$(launch_log_path)"
  mkdir -p "$(dirname "$log_path")" 2>/dev/null || true
}

launch_log() {
  local log_path
  log_path="$(launch_log_path)"
  ensure_launch_log_dir
  printf '[%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >> "$log_path" 2>/dev/null || true
}

begin_launch_log() {
  local log_path
  log_path="$(launch_log_path)"
  ensure_launch_log_dir
  printf '\n[%s] === ./illo %s ===\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >> "$log_path" 2>/dev/null || true
  dim "Launcher log: $log_path"
}

log_phase() {
  launch_log "phase: $*"
}

path_prepend_once() {
  local dir="${1:-}"
  if [ -z "$dir" ] || [ ! -d "$dir" ]; then
    return 0
  fi
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) export PATH="$dir:$PATH" ;;
  esac
}

LOCAL_DENO_INSTALL="${ILLO_DENO_INSTALL:-$ROOT/.runtime/deno}"
LOCAL_BROWSER_RUNTIME_DIR="${ILLO_BROWSER_RUNTIME_DIR:-$ROOT/.runtime/browser}"
LOCAL_BROWSER_CHROME_FOR_TESTING_DIR="${ILLO_BROWSER_CHROME_FOR_TESTING_DIR:-$LOCAL_BROWSER_RUNTIME_DIR/chrome-for-testing}"
export ILLO_PROJECT_ROOT="${ILLO_PROJECT_ROOT:-$ROOT}"
export ILLO_BROWSER_RUNTIME_DIR="$LOCAL_BROWSER_RUNTIME_DIR"
export ILLO_BROWSER_CHROME_FOR_TESTING_DIR="$LOCAL_BROWSER_CHROME_FOR_TESTING_DIR"
path_prepend_once "$LOCAL_DENO_INSTALL/bin"

find_docker_bin() {
  local detected=""
  local candidates=(
    "docker"
    "podman"
    "/usr/local/bin/docker"
    "/opt/homebrew/bin/docker"
    "$HOME/.docker/bin/docker"
    "/Applications/Docker.app/Contents/Resources/bin/docker"
    "/usr/local/bin/podman"
    "/opt/homebrew/bin/podman"
  )

  local candidate
  for candidate in "${candidates[@]}"; do
    if [ "$candidate" = "docker" ] || [ "$candidate" = "podman" ]; then
      if detected="$(command -v "$candidate" 2>/dev/null)"; then
        echo "$detected"
        return 0
      fi
    elif [ -x "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done

  return 1
}

ensure_docker_path() {
  if [ -n "${DOCKER_BIN:-}" ] && [ -x "$DOCKER_BIN" ]; then
    return 0
  fi

  local detected=""
  if ! detected="$(find_docker_bin)"; then
    return 1
  fi

  DOCKER_BIN="$detected"
  export PATH="$(dirname "$DOCKER_BIN"):$PATH"
  return 0
}

try_start_docker_daemon() {
  [ "$DOCKER_START_ATTEMPTED" = "0" ] || return 1
  DOCKER_START_ATTEMPTED=1

  [ -n "${DOCKER_BIN:-}" ] || return 1
  [ "$(basename "$DOCKER_BIN")" = "docker" ] || return 1
  is_truthy "${ILLO_AUTO_START_DOCKER:-1}" || return 1
  command -v systemctl &>/dev/null || return 1

  dim "Docker is installed but not responding — trying to start the Docker service..."
  if run_with_timeout 25 systemctl start docker >/dev/null 2>&1 || \
     run_with_timeout 25 sudo -n systemctl start docker >/dev/null 2>&1; then
    sleep 2
    run_with_timeout 5 "$DOCKER_BIN" info >/dev/null 2>&1 && return 0
  fi

  return 1
}

find_postgres_bin_dir() {
  local tool dir found=""
  for tool in pg_ctl postgres initdb psql; do
    if command -v "$tool" >/dev/null 2>&1; then
      dir="$(dirname "$(command -v "$tool")")"
      if [ -x "$dir/pg_ctl" ] && [ -x "$dir/postgres" ] && [ -x "$dir/initdb" ] && [ -x "$dir/psql" ]; then
        echo "$dir"
        return 0
      fi
    fi
  done

  for dir in /usr/lib/postgresql/*/bin /opt/homebrew/opt/postgresql@*/bin /usr/local/opt/postgresql@*/bin /Applications/Postgres.app/Contents/Versions/*/bin; do
    [ -d "$dir" ] || continue
    if [ -x "$dir/pg_ctl" ] && [ -x "$dir/postgres" ] && [ -x "$dir/initdb" ] && [ -x "$dir/psql" ]; then
      found="$dir"
    fi
  done

  [ -n "$found" ] || return 1
  echo "$found"
}

find_psql_bin() {
  local pg_bin_dir
  if command -v psql >/dev/null 2>&1; then
    command -v psql
    return 0
  fi

  if pg_bin_dir="$(find_postgres_bin_dir)"; then
    echo "$pg_bin_dir/psql"
    return 0
  fi

  return 1
}

psql_available() {
  find_psql_bin >/dev/null 2>&1
}

run_psql_no_prompt() {
  local psql_bin
  psql_bin="$(find_psql_bin)" || return 1
  env PGCONNECT_TIMEOUT="${PGCONNECT_TIMEOUT:-3}" "$psql_bin" -w "$@"
}

db_connection_ok() {
  local db_host="$1"
  local db_port="$2"
  local db_name="$3"
  local db_user="$4"
  local db_pass="$5"

  if psql_available; then
    export PGPASSWORD="$db_pass"
    run_psql_no_prompt -h "$db_host" -p "$db_port" -U "$db_user" -d "$db_name" -c "SELECT 1" \
      >/dev/null 2>&1
    local status=$?
    unset PGPASSWORD
    return "$status"
  fi

  local python_bin
  python_bin="$(launcher_python_bin)"
  DB_HOST="$db_host" \
  DB_PORT="$db_port" \
  DB_NAME="$db_name" \
  DB_USER="$db_user" \
  DB_PASSWORD="$db_pass" \
    "$python_bin" - <<'PY' >/dev/null 2>&1
import os
import sys

try:
    import psycopg2
except Exception:
    sys.exit(1)

try:
    conn = psycopg2.connect(
        host=os.environ["DB_HOST"],
        port=int(os.environ["DB_PORT"]),
        dbname=os.environ["DB_NAME"],
        user=os.environ["DB_USER"],
        password=os.environ["DB_PASSWORD"],
        connect_timeout=3,
    )
    conn.close()
except Exception:
    sys.exit(1)
PY
}

# ── Source optional env files ─────────────────────────────

runtime_env_file_path() {
  if [ -n "${ILLO_RUNTIME_ENV_FILE:-}" ]; then
    case "$ILLO_RUNTIME_ENV_FILE" in
      /*) echo "$ILLO_RUNTIME_ENV_FILE" ;;
      *) echo "$ROOT/$ILLO_RUNTIME_ENV_FILE" ;;
    esac
    return 0
  fi

  local private_home="${ILLO_PRIVATE_HOME:-.illo}"
  case "$private_home" in
    /*) echo "$private_home/runtime.env" ;;
    *) echo "$ROOT/$private_home/runtime.env" ;;
  esac
}

launcher_python_bin() {
  if [ -x "$ROOT/venv/bin/python3" ]; then
    echo "$ROOT/venv/bin/python3"
  else
    echo "python3"
  fi
}

production_env_file_path() {
  if [ -n "${ILLO_PRODUCTION_ENV_FILE:-}" ]; then
    case "$ILLO_PRODUCTION_ENV_FILE" in
      /*) echo "$ILLO_PRODUCTION_ENV_FILE" ;;
      *) echo "$ROOT/$ILLO_PRODUCTION_ENV_FILE" ;;
    esac
    return 0
  fi

  echo "$HOME/.config/illo-brain/production.env"
}

source_env_file_defaults() {
  local file="$1"
  local preserve_empty="${2:-1}"
  [ -f "$file" ] || return 0

  local keys=()
  local had=()
  local values=()
  local line trimmed key idx

  while IFS= read -r line || [ -n "$line" ]; do
    trimmed="${line#"${line%%[![:space:]]*}"}"
    if [[ "$trimmed" =~ ^(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)= ]]; then
      key="${BASH_REMATCH[2]}"
      keys+=("$key")
      if [ "${!key+x}" = "x" ] && { [ "$preserve_empty" = "1" ] || [ -n "${!key}" ]; }; then
        had+=("1")
        values+=("${!key}")
      else
        had+=("0")
        values+=("")
      fi
    fi
  done < "$file"

  set -a
  source "$file" 2>/dev/null || true
  set +a

  for idx in "${!keys[@]}"; do
    if [ "${had[$idx]}" = "1" ]; then
      export "${keys[$idx]}=${values[$idx]}"
    fi
  done
}

source_env() {
  source_env_file_defaults ".env"
  source_env_file_defaults "$(runtime_env_file_path)" 0
}

generate_runtime_secret() {
  local name="$1"
  local python_bin="python3"
  if [ -x "$ROOT/venv/bin/python3" ]; then
    python_bin="$ROOT/venv/bin/python3"
  fi

  "$python_bin" - "$name" <<'PY'
import base64
import os
import secrets
import sys

name = sys.argv[1]
if name == "VAULT_MASTER_KEY":
    print(base64.urlsafe_b64encode(os.urandom(32)).decode("ascii"))
else:
    print(secrets.token_urlsafe(64))
PY
}

append_runtime_env_assignment() {
  local file="$1"
  local key="$2"
  local value="$3"
  printf '%s=%s\n' "$key" "$value" >> "$file"
}

ensure_runtime_secrets() {
  local env_file env_dir value wrote=0
  env_file="$(runtime_env_file_path)"
  env_dir="$(dirname "$env_file")"

  mkdir -p "$env_dir" 2>/dev/null || {
    warn "Could not create runtime-private env directory: $env_dir"
    return 0
  }
  chmod 700 "$env_dir" 2>/dev/null || true

  if [ ! -f "$env_file" ]; then
    (umask 077 && {
      echo "# Generated by ./illo for this local checkout."
      echo "# Real environment variables or .env values override these defaults."
    } > "$env_file") 2>/dev/null || {
      warn "Could not create runtime-private env file: $env_file"
      return 0
    }
  fi
  chmod 600 "$env_file" 2>/dev/null || true

  if [ -z "${SECRET_KEY:-}" ]; then
    value="$(generate_runtime_secret SECRET_KEY)" || value=""
    if [ -n "$value" ]; then
      append_runtime_env_assignment "$env_file" "SECRET_KEY" "$value"
      export SECRET_KEY="$value"
      wrote=1
    fi
  fi

  if [ -z "${VAULT_MASTER_KEY:-}" ]; then
    value="$(generate_runtime_secret VAULT_MASTER_KEY)" || value=""
    if [ -n "$value" ]; then
      append_runtime_env_assignment "$env_file" "VAULT_MASTER_KEY" "$value"
      export VAULT_MASTER_KEY="$value"
      wrote=1
    fi
  fi

  if [ $wrote -eq 1 ]; then
    dim "Generated local runtime secrets in $env_file"
  fi
}

sync_production_service_env() {
  local env_file dotenv_file runtime_file python_bin
  env_file="$(production_env_file_path)"
  dotenv_file="$ROOT/.env"
  runtime_file="$(runtime_env_file_path)"
  python_bin="$(launcher_python_bin)"

  mkdir -p "$(dirname "$env_file")" 2>/dev/null || {
    warn "Could not create production env directory: $(dirname "$env_file")"
    return 1
  }

  "$python_bin" - "$env_file" "$dotenv_file" "$runtime_file" <<'PY'
import os
import re
import sys
from collections import OrderedDict
from pathlib import Path

env_path = Path(sys.argv[1])
source_paths = [Path(item) for item in sys.argv[2:]]
assignment = re.compile(r"^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$")

required_keys = (
    "DATABASE_URL",
    "DB_URL",
    "BRAIN_DB_URL",
    "DB_HOST",
    "DB_PORT",
    "DB_NAME",
    "DB_USER",
    "DB_PASSWORD",
    "DB_POOL_MIN",
    "DB_POOL_MAX",
    "SECRET_KEY",
    "VAULT_MASTER_KEY",
    "FLASK_SECRET_KEY",
    "OPENCLAW_GATEWAY_TOKEN",
    "ILLO_API_TOKEN",
    "CORS_ORIGINS",
    "RATE_LIMIT",
    "RATE_WINDOW",
    "EMBEDDING_BACKEND",
    "EMBEDDING_DIM",
    "EMBEDDING_API_PROVIDER",
    "EMBEDDING_API_MODEL",
    "EMBEDDING_API_KEY",
    "EMBEDDING_CPU_MODEL",
    "EMBEDDING_MODEL",
    "EMBEDDING_MODEL_PATH",
    "MEMORY_RERANKER",
    "OPENAI_API_KEY",
    "OPENAI_ORG_ID",
    "OPENAI_PROJECT",
)


def parse_value(raw: str) -> str:
    value = raw.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
        value = value[1:-1]
    return value


def read_assignments(path: Path) -> OrderedDict[str, str]:
    values: OrderedDict[str, str] = OrderedDict()
    if not path.exists():
        return values
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        match = assignment.match(line)
        if match:
            values[match.group(1)] = parse_value(match.group(2))
    return values


def env_value(key: str) -> str | None:
    value = os.environ.get(key)
    if value is None or value == "":
        return None
    return value


def systemd_quote(value: str) -> str:
    if re.fullmatch(r"[A-Za-z0-9_@%+=:,./-]*", value):
        return value
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


merged = read_assignments(env_path)
ordered_keys: list[str] = list(merged)
for path in source_paths:
    for key in read_assignments(path):
        if key not in ordered_keys:
            ordered_keys.append(key)
for key in required_keys:
    if key not in ordered_keys:
        ordered_keys.append(key)

for key in ordered_keys:
    value = env_value(key)
    if value is not None:
        merged[key] = value

env_path.parent.mkdir(parents=True, exist_ok=True)
with env_path.open("w", encoding="utf-8") as handle:
    handle.write("# Generated by ./illo for Illo Brain user services.\n")
    handle.write("# Keep this file private; it may contain API keys and vault secrets.\n")
    for key, value in merged.items():
        if "\n" in value:
            continue
        handle.write(f"{key}={systemd_quote(value)}\n")
env_path.chmod(0o600)
print(env_path)
PY
}

install_user_service_template() {
  local source_path="$1"
  local dest_dir="$HOME/.config/systemd/user"
  local dest_path="$dest_dir/$(basename "$source_path")"
  local python_bin

  [ -f "$source_path" ] || return 0
  python_bin="$(launcher_python_bin)"
  mkdir -p "$dest_dir" 2>/dev/null || {
    warn "Could not create systemd user service directory: $dest_dir"
    return 1
  }

  "$python_bin" - "$source_path" "$dest_path" "$ROOT" <<'PY'
import sys
from pathlib import Path

source = Path(sys.argv[1])
dest = Path(sys.argv[2])
root = sys.argv[3]

text = source.read_text(encoding="utf-8").replace("%h/illo-brain", root)
dest.write_text(text, encoding="utf-8")
print(dest)
PY
}

systemd_user_ready() {
  command -v systemctl &>/dev/null || return 1
  run_logged_timeout 5 systemctl --user show-environment >/dev/null 2>&1
}

restart_or_drain_production_worker() {
  run_logged_timeout 10 systemctl --user enable cortex-worker.service >/dev/null 2>&1 || return 1

  local active_runs
  active_runs="$(active_agent_run_count || echo unknown)"
  if [ "$active_runs" = "0" ]; then
    run_logged_timeout 15 systemctl --user restart cortex-worker.service >/dev/null 2>&1
    dim "cortex-worker restarted for this checkout"
    return $?
  fi
  if [ "$active_runs" = "unknown" ]; then
    warn "Could not count active AgentRuns; restarting cortex-worker so this checkout owns the queue"
    run_logged_timeout 15 systemctl --user restart cortex-worker.service >/dev/null 2>&1
    dim "cortex-worker restarted for this checkout"
    return $?
  fi

  warn "$active_runs AgentRun(s) active; draining cortex-worker instead of restarting it"
  run_logged_timeout 10 systemctl --user kill --kill-who=main --signal=TERM cortex-worker.service >/dev/null 2>&1 || true
}

ensure_production_user_services() {
  if is_truthy "${CORTEX_INLINE_DISPATCHER:-0}"; then
    dim "Inline dispatcher enabled; skipping standalone worker service startup"
    return 0
  fi
  if ! systemd_user_ready; then
    warn "systemd user manager is unavailable; standalone worker services cannot be started"
    return 1
  fi

  sync_production_service_env >/dev/null || return 1
  install_user_service_template "ops/cortex-worker.service" >/dev/null || return 1
  install_user_service_template "ops/illo-scheduler.service" >/dev/null || return 1
  install_user_service_template "ops/illo-embed.service" >/dev/null || true
  install_user_service_template "ops/gpu_server/illo-gpu-server.service" >/dev/null || true
  run_logged_timeout 10 systemctl --user daemon-reload >/dev/null 2>&1 || return 1

  restart_or_drain_production_worker || return 1
  run_logged_timeout 10 systemctl --user enable illo-scheduler.service >/dev/null 2>&1 || return 1
  run_logged_timeout 15 systemctl --user restart illo-scheduler.service >/dev/null 2>&1 || return 1
  dim "illo-scheduler restarted for this checkout"
}

unload_unused_embedding_worker() {
  if [ "${EMBEDDING_BACKEND:-api}" = "gpu" ]; then
    return 0
  fi
  curl --max-time 5 -fsS -X POST http://127.0.0.1:9800/models/embedding/unload >/dev/null 2>&1 || return 0
  dim "Stopped unused GPU embedding worker; EMBEDDING_BACKEND=${EMBEDDING_BACKEND:-api}"
}

database_env_var_names() {
  local db_var
  local names=()
  for db_var in "${DATABASE_ENV_VARS[@]}"; do
    if [ "${!db_var+x}" = "x" ]; then
      names+=("$db_var")
    fi
  done
  if [ ${#names[@]} -gt 0 ]; then
    printf '%s' "${names[*]}"
  fi
}

apply_uninstall_database_env_reset() {
  [ -f "$UNINSTALL_DB_ENV_RESET_MARKER" ] || return 0

  if [ -f ".env" ]; then
    rm -f "$UNINSTALL_DB_ENV_RESET_MARKER"
    return 0
  fi

  local db_var
  local reset_any=0
  for db_var in "${DATABASE_ENV_VARS[@]}"; do
    if [ "${!db_var+x}" = "x" ]; then
      unset "$db_var"
      reset_any=1
    fi
  done

  rm -f "$UNINSTALL_DB_ENV_RESET_MARKER"
  if [ $reset_any -eq 1 ]; then
    dim "Ignoring inherited database environment once after ./illo uninstall"
  fi
}

record_uninstall_database_env_reset() {
  local dry_run="$1"
  if [ "$dry_run" = "1" ]; then
    echo "Would ignore inherited database environment once on the next setup run"
    return 0
  fi

  {
    echo "# Created by ./illo uninstall."
    echo "# The next ./illo setup/run will ignore inherited database env vars once when no .env exists."
    echo "# Remove this file if you intentionally want shell DB_* values to apply immediately."
  } > "$UNINSTALL_DB_ENV_RESET_MARKER" 2>/dev/null || {
    warn "Could not record one-time database environment reset at $UNINSTALL_DB_ENV_RESET_MARKER"
    return 0
  }
  dim "Next ./illo setup will ignore inherited database env vars once unless you create .env first"
}

stop_conflicting_services() {
  if ! command -v systemctl &>/dev/null; then
    launch_log "systemctl not found; skipping user-service cleanup"
    return
  fi

  launch_log "checking systemd user manager"
  if ! run_logged_timeout 5 systemctl --user show-environment; then
    warn "systemd user manager did not respond; skipping user-service cleanup"
    return
  fi

  local services=("$@")
  if [ ${#services[@]} -eq 0 ]; then
    services=("cortex-worker" "illo-dashboard" "illo-api" "illo-embed" "illo-gpu-server")
  fi
  local stopped=0

  for svc in "${services[@]}"; do
    launch_log "checking user service: $svc"
    if run_logged_timeout 5 systemctl --user cat "$svc"; then
      if [ $stopped -eq 0 ]; then
        warn "Stopping conflicting user services so ./illo owns the runtime..."
        stopped=1
      fi
      launch_log "stopping user service: $svc"
      if run_logged_timeout 10 systemctl --user stop "$svc"; then
        dim "Stopped $svc"
      else
        warn "Timed out stopping $svc; forcing its user-service processes down"
        launch_log "forcing user service down: $svc"
        run_logged_timeout 5 systemctl --user kill --signal=KILL "$svc" || true
        run_logged_timeout 5 systemctl --user stop --no-block "$svc" || true
      fi
    else
      launch_log "user service not installed or unavailable: $svc"
    fi
  done
}

active_agent_run_count() {
  "$ROOT/venv/bin/python3" - <<'PY' 2>/dev/null
from sqlalchemy import func, select

from brain.platform.db.models.agent_run import AgentRunRow
from brain.platform.db.repositories.unit_of_work import UnitOfWork

active = ("starting", "running", "verifying")
with UnitOfWork() as uow:
    count = uow.session.scalar(
        select(func.count()).select_from(AgentRunRow).where(AgentRunRow.status.in_(active))
    )
print(int(count or 0))
PY
}

api_owned_active_run_count() {
  local owner_pids="$1"
  if [ -z "$owner_pids" ]; then
    echo "0"
    return 0
  fi
  ILLO_RUNNER_OWNER_PIDS="$owner_pids" "$ROOT/venv/bin/python3" - <<'PY' 2>/dev/null
import os

from sqlalchemy import select

from brain.platform.db.models.agent_run import AgentRunRow
from brain.platform.db.repositories.unit_of_work import UnitOfWork

pids = {
    item.strip()
    for item in os.environ.get("ILLO_RUNNER_OWNER_PIDS", "").replace(",", " ").split()
    if item.strip()
}
active = ("starting", "running", "verifying")
count = 0
with UnitOfWork() as uow:
    rows = uow.session.scalars(select(AgentRunRow).where(AgentRunRow.status.in_(active))).all()
    for row in rows:
        metadata = row.metadata_ if isinstance(row.metadata_, dict) else {}
        heartbeat = metadata.get("runner_heartbeat")
        heartbeat = heartbeat if isinstance(heartbeat, dict) else {}
        token = str(heartbeat.get("token") or "")
        owner_pid = token.split(":", 1)[0] if ":" in token else ""
        if owner_pid in pids:
            count += 1
print(count)
PY
}

guard_api_port_kill() {
  local api_pids="${1:-}"
  if [ -z "$api_pids" ] || [ "${ILLO_FORCE_KILL_ACTIVE_RUNS:-0}" = "1" ]; then
    return 0
  fi

  local owned_runs
  if ! owned_runs="$(api_owned_active_run_count "$api_pids")"; then
    err "Cannot verify whether API pid(s) $api_pids own active AgentRuns."
    err "Refusing to kill port 8000. Set ILLO_FORCE_KILL_ACTIVE_RUNS=1 to override."
    exit 1
  fi
  if [ "${owned_runs:-0}" != "0" ]; then
    err "Refusing to kill API pid(s) $api_pids because they own $owned_runs active AgentRun(s)."
    err "Let the runs finish, drain the worker, or set ILLO_FORCE_KILL_ACTIVE_RUNS=1 if you intend to kill them."
    exit 1
  fi
}

