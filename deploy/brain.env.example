# The brain environment file. Only the brain container loads it. Keep it at mode 600,
# outside every checkout. The brain reads it once at start: after a change, recreate the
# brain container and check GET /providers.
#
# A provider with no key is not available, except chatgpt: its tokens come with each run.
# Built-in providers: chatgpt, openai, anthropic. Each knows its wire and its base URL.
# ILLO_PROVIDER_<NAME>_BASE_URL changes the base URL of a provider.

# The OpenAI API (Responses wire). Also the default provider for voice transcription.
ILLO_PROVIDER_OPENAI_API_KEY=
# The Anthropic API, through the Claude Agent SDK.
ILLO_PROVIDER_ANTHROPIC_API_KEY=

# A custom provider also sets its wire (responses or chat), its base URL, and its
# capabilities, for example images,web_search,effort:low,effort:high.
# ILLO_PROVIDER_LOCAL_API_KEY=
# ILLO_PROVIDER_LOCAL_WIRE=chat
# ILLO_PROVIDER_LOCAL_BASE_URL=http://models.example:8000/v1
# ILLO_PROVIDER_LOCAL_CAPABILITIES=effort:none

# Maximum concurrent brain workers.
ILLO_BRAIN_CONCURRENCY=4
# The longest run in seconds. A route's timeout_s cannot go above it.
ILLO_BRAIN_MAX_TIMEOUT_S=1800
