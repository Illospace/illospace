# Required to start. The installer creates values for these keys.
# Database password. Use letters and numbers so the database URL needs no escaping.
POSTGRES_PASSWORD=
# Database URL inside the Compose network.
ILLO_DATABASE_URL=
# Absolute host workspace folder. The app mounts it at /workspace.
ILLO_WORKSPACE_DIR=
# Fernet key for the vault. Keep this key with the database backup.
ILLO_VAULT_KEY=
# Shared secret for the app and brain service.
ILLO_BRAIN_SECRET=
# Local port for the MCP endpoint.
ILLO_PORT=8484
# User ID for the app. Use the owner of the workspace folder.
ILLO_UID=10001
# Group ID for the app. Use the group of the workspace folder.
ILLO_GID=10001
# App URL seen by the brain. Compose sets this value.
ILLO_PUBLIC_URL=http://illo:8080
# Brain service URL inside the Compose network.
ILLO_BRAIN_URL=http://brain:8080
# Apply migrations before the app starts. The updater applies them separately.
ILLO_MIGRATE_ON_START=1
# Optional secret for the loopback reload route. File checks also reload the workspace.
ILLO_RELOAD_TOKEN=

# Slack.
# Bot token from the Slack app. Blank disables Slack.
ILLO_SLACK_BOT_TOKEN=
# App token with the connections:write scope for Socket Mode.
ILLO_SLACK_APP_TOKEN=

# GitHub.
# Optional token. A GitHub App can replace it.
ILLO_GITHUB_TOKEN=
# Optional GitHub App ID.
ILLO_GITHUB_APP_ID=
# Container path of the GitHub App key. Mount the external file before use.
ILLO_GITHUB_APP_PRIVATE_KEY_FILE=
# Optional GitHub App installation ID.
ILLO_GITHUB_APP_INSTALLATION_ID=

# Brain.
# Runtime override: claude, openai_compat, or echo. Blank uses workspace/illo.yaml.
ILLO_BRAIN_RUNTIME=
# Optional model override. Blank uses workspace/illo.yaml.
ILLO_BRAIN_MODEL=
# Anthropic API key for the Claude Agent SDK.
ANTHROPIC_API_KEY=
# Optional Anthropic API base URL.
ANTHROPIC_BASE_URL=
# API key for the openai_compat runtime.
OPENAI_API_KEY=
# Optional OpenAI-compatible API base URL.
OPENAI_BASE_URL=

# Maximum concurrent brain workers.
ILLO_BRAIN_CONCURRENCY=4
# Maximum active seconds for a brain worker.
ILLO_BRAIN_TIMEOUT_S=120
# Claude effort accepted by the Agent SDK.
ILLO_BRAIN_EFFORT=low

# Email.
# Optional IMAP host.
ILLO_EMAIL_HOST=
# Optional mailbox user.
ILLO_EMAIL_USER=
# Receiving server identity in Authentication-Results. Blank disables email.
# Use topmost only if the provider always adds its own header above sender headers.
ILLO_EMAIL_AUTHSERV_ID=
# Optional mailbox password.
ILLO_EMAIL_PASSWORD=

# Google.
# Set Google connector credentials with illo secret set. No key belongs in the workspace.

# Limits.
# Maximum memory for the app.
ILLO_MEMORY=768m
# Maximum CPUs for the app.
ILLO_CPUS=1.0
# Maximum processes for the app.
ILLO_PIDS=128
# Maximum memory for the brain.
ILLO_BRAIN_MEMORY=1g
# Maximum CPUs for the brain.
ILLO_BRAIN_CPUS=1.0
# Maximum processes for the brain.
ILLO_BRAIN_PIDS=128
# Maximum memory for Postgres.
ILLO_POSTGRES_MEMORY=512m
# Maximum CPUs for Postgres.
ILLO_POSTGRES_CPUS=1.0
# Minimum open database connections.
ILLO_POOL_MIN_SIZE=1
# Maximum open database connections.
ILLO_POOL_MAX_SIZE=10
# Seconds between workspace checks.
ILLO_WORKSPACE_CHECK_SECONDS=30
# Number of health checks before an install or update fails.
ILLO_HEALTH_ATTEMPTS=60

# Maintenance.
# Branch that the updater follows. Set next until the rebuild merges into main.
ILLO_DEPLOY_BRANCH=main
# Compose project name. Keep this value after the first install.
ILLO_PROJECT_NAME=illo
# Image name prefix. SHA tags keep the last good images available.
ILLO_IMAGE_PREFIX=illo
# Absolute folder for update state and logs.
ILLO_STATE_DIR=
# Absolute backup folder outside the checkout.
ILLO_BACKUP_DIR=
# Number of successful database backups to keep.
ILLO_BACKUP_KEEP=14
