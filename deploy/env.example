# Database URL. Keep credentials outside the checkout.
ILLO_DATABASE_URL=postgresql://illo:illo@127.0.0.1:5432/illo
# Workspace folder. Use a private folder for a real team.
ILLO_WORKSPACE_DIR=/absolute/path/to/workspace
# Fernet key. Generate it with cryptography. Required only for the vault.
ILLO_VAULT_KEY=
# URL that the brain service uses to reach Illo.
ILLO_PUBLIC_URL=http://127.0.0.1:8000
# Brain service URL.
ILLO_BRAIN_URL=http://127.0.0.1:8001
# Optional brain runtime override. Otherwise use illo.yaml.
ILLO_BRAIN_RUNTIME=
# Optional brain model override. Otherwise use illo.yaml.
ILLO_BRAIN_MODEL=
# Optional Slack bot token. Without it, Illo still starts.
ILLO_SLACK_BOT_TOKEN=
# Optional Slack Socket Mode token.
ILLO_SLACK_APP_TOKEN=
# Optional GitHub token. Use a GitHub App instead if available.
ILLO_GITHUB_TOKEN=
# Optional GitHub App ID.
ILLO_GITHUB_APP_ID=
# Optional private key file. Keep it outside every checkout.
ILLO_GITHUB_APP_PRIVATE_KEY_FILE=
# Optional GitHub App installation ID.
ILLO_GITHUB_APP_INSTALLATION_ID=
# Optional IMAP host for the email builder.
ILLO_EMAIL_HOST=
# Optional mailbox user.
ILLO_EMAIL_USER=
# Optional mailbox password.
ILLO_EMAIL_PASSWORD=
# Revision shown by the health check.
ILLO_REVISION=unknown
# Apply migrations at startup.
ILLO_MIGRATE_ON_START=true
# Secret for loopback-only POST /admin/reload. Blank disables the route.
ILLO_RELOAD_TOKEN=
# Seconds between workspace file checks.
ILLO_WORKSPACE_CHECK_SECONDS=30
# Minimum open database connections.
ILLO_POOL_MIN_SIZE=1
# Maximum open database connections.
ILLO_POOL_MAX_SIZE=10
