# Copy this file to deploy/compose/.env, then run:
#   ./illo deploy init --domain team.example.com --email admin@example.com
#
# Keep deploy/compose/.env private. It contains live secrets.

COMPOSE_PROJECT_NAME=illospace

# Published images are the intended production path. Until release images are
# available, run `./illo deploy up --build --no-pull` to build locally.
ILLO_API_IMAGE=ghcr.io/illospace/api:latest
ILLO_WEB_IMAGE=ghcr.io/illospace/web:latest

# Public HTTPS endpoint served by Caddy after first-owner setup.
ILLO_DOMAIN=team.example.com
ILLO_ADMIN_EMAIL=admin@example.com
ILLO_PUBLIC_URL=https://team.example.com
# Fresh installs bind public HTTP/HTTPS to loopback. Create the first owner over
# an SSH tunnel, then run `./illo deploy publish` to bind Caddy publicly.
ILLO_PUBLIC_BIND=127.0.0.1
ILLO_HTTP_PORT=80
ILLO_HTTPS_PORT=443
# Private first-boot endpoint. From your workstation:
#   ssh -L 8080:127.0.0.1:8080 <ssh-user>@<server>
#   open http://localhost:8080
ILLO_PRIVATE_HTTP_PORT=8080

# Local-only API port for operator health checks.
ILLO_API_PORT=8000
# Set to 1 when doctor should also check the public URL from this machine.
ILLO_CHECK_PUBLIC_URL=0

# Generated by ./illo deploy init.
SECRET_KEY=
VAULT_MASTER_KEY=

# Postgres runs inside the Compose stack by default.
DB_NAME=illospace
DB_USER=illospace
DB_PASSWORD=
DB_POOL_MAX=10

# Production guardrails.
ILLO_ENV=production
ILLO_VALIDATE_MIGRATIONS=1
ILLO_ALLOW_LOCAL_CODEX_AUTH_FALLBACK=0
ILLO_OPENAI_OAUTH_SERVER_CALLBACK=1

# Model provider credentials are configured inside Illospace after first boot
# from the System/Access screens. They are encrypted with VAULT_MASTER_KEY and
# stored in Postgres, not in this Compose env file.

# Embeddings. API mode is the lowest-friction team-server default.
EMBEDDING_BACKEND=api
EMBEDDING_API_PROVIDER=gemini
EMBEDDING_API_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# AgentRun worker limits.
CORTEX_MAX_CONCURRENT=10
CORTEX_MAX_RUNTIME=600
CORTEX_EMBEDDING_READY_TIMEOUT_SECONDS=300
ILLO_AGENT_RUNNER_DRAIN_TIMEOUT_SECONDS=infinity
