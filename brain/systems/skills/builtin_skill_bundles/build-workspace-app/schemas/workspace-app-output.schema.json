{
  "type": "object",
  "required": [
    "app_name",
    "data_ownership",
    "renderer",
    "verification"
  ],
  "properties": {
    "app_name": {
      "type": "string"
    },
    "data_ownership": {
      "enum": [
        "app_local",
        "domain_backed",
        "hybrid"
      ]
    },
    "domain_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "renderer": {
      "enum": [
        "app-capsule",
        "generated-ui-app",
        "sandboxed-html-app"
      ],
      "default": "app-capsule"
    },
    "source_kind": {
      "enum": [
        "json",
        "html"
      ],
      "default": "html"
    },
    "state_bridge_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "external_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action_key",
          "effects",
          "executor"
        ],
        "properties": {
          "action_key": {
            "type": "string"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "executor": {
            "enum": [
              "deferred",
              "registered"
            ]
          },
          "domain_binding": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
